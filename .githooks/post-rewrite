#!/bin/sh
# Reconstruye el grafo local al terminar un rebase si cambió código. Nunca lo falla.
# $1 = rebase o amend; amend lo cubre post-commit. Se compara la punta anterior (ORIG_HEAD,
# que rebase fija al empezar) con la nueva: comparar commit a commit por stdin se perdería
# lo que trae la base nueva.
trap 'exit 0' EXIT
lib="$(dirname "$0")/lib-graphify.sh"
[ -r "$lib" ] || exit 0
. "$lib"
[ "$1" = "rebase" ] || exit 0
graphify_precheck rebase || exit 0
if ! git rev-parse -q --verify ORIG_HEAD >/dev/null 2>&1; then
  graphify_rebuild
elif git -c core.quotePath=false diff --no-renames --name-only ORIG_HEAD HEAD 2>/dev/null | graphify_relevant; then
  graphify_rebuild
else
  echo "[graphify] rebase sin código: no se reconstruye"
fi
exit 0
