#!/usr/bin/env bash
# Rechaza secretos, planillas e imágenes fuera de los recursos del frontend
# (ver docs/flujo-de-trabajo.md, "Las rejas" y "Datos reales").
set -u
estado=0

while IFS= read -r -d '' f; do
  base=$(basename -- "$f")
  minus=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
  case "$base" in
    .env.example) ;;
    .env*)
      echo "pre-commit: $f parece un archivo de secretos (.env*)." >&2
      estado=1
      ;;
  esac
  case "$minus" in
    *.xlsx|*.xls|*.xlsm|*.csv|*.ods)
      echo "pre-commit: $f es una planilla. Los datos del club no entran al repo." >&2
      estado=1
      ;;
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.heic|*.heif|*.bmp|*.tif|*.tiff|*.avif|*.ico|*.svg)
      case "$f" in
        frontend/public/*|frontend/src/assets/*) ;;
        *)
          echo "pre-commit: $f es una imagen fuera de frontend/public o frontend/src/assets." >&2
          estado=1
          ;;
      esac
      ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# Contenido: URLs de base de datos con contraseña hacia algo que no sea localhost, y
# asignaciones de tokens de las plataformas con un valor.
agregadas=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -vE '^\+\+\+ ')
if printf '%s\n' "$agregadas" | grep -E 'postgres(ql)?://[^[:space:]/:@]+:[^[:space:]/@]+@' \
  | grep -vqE '@(localhost|127\.0\.0\.1|\[::1\])[:/]'; then
  echo "pre-commit: hay una URL de base de datos con contraseña que no es localhost." >&2
  estado=1
fi
if printf '%s\n' "$agregadas" | grep -qE '(RAILWAY_TOKEN|VERCEL_TOKEN|RAILWAY_API_TOKEN)[[:space:]]*[=:][[:space:]]*["'\'']?[A-Za-z0-9_-]{16,}'; then
  echo "pre-commit: parece haber un token de Railway o Vercel en el cambio." >&2
  estado=1
fi

exit $estado
