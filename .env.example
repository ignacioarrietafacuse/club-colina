# Copiar a .env (que nunca se sube) para trabajar en local.
# El .env local apunta SIEMPRE a localhost. La URL de la base de producción no se guarda
# en ningún .env: en producción las variables viven en Railway y Vercel.

# --- Frontend (Vercel en producción) -----------------------------------------
# Dirección pública que va grabada en los QR (la misma que PUBLIC_BASE_URL). Obligatoria para
# `pnpm check` y para el build del frontend: sin ella falla. Vite la lee de este .env de la
# raíz; con `pnpm dev` sin ella usa http://localhost:5173. El build de Vercel no acepta
# localhost. Nunca pongas un secreto en una variable VITE_*: termina en el bundle público.
# En producción vive en Vercel (Production y Preview) y en .github/workflows/ci.yml. Railway no
# la necesita: `pnpm build` de la raíz compila solo el backend (con shared adentro). Production
# usa https://panel.clubcolina.com; Preview y el CI siguen con https://club-colina.vercel.app.
VITE_PUBLIC_BASE_URL=http://localhost:5173

# --- Backend (Railway en producción) ---------------------------------------
# Postgres local de docker-compose.yml.
DATABASE_URL=postgres://club:club@localhost:5432/club_colina
# URL pública del frontend; va grabada en los QR. En producción, https://panel.clubcolina.com
PUBLIC_BASE_URL=http://localhost:5173
# Orígenes extra aceptados en escrituras (coma). En producción, vacía: club-colina.vercel.app
# redirige a https://panel.clubcolina.com, así que ningún navegador escribe desde ahí.
ORIGENES_PERMITIDOS=
PORT=3000
LOG_LEVEL=info
# En Railway: NODE_ENV=production y MIGRAR_AL_ARRANCAR=si. Con las dos, el backend aplica
# las migraciones pendientes al arrancar contra la base de Railway. En local se dejan así:
# el servidor solo migra localhost.
NODE_ENV=development
MIGRAR_AL_ARRANCAR=no
# Secreto compartido con el middleware de Vercel (misma variable en Railway y en Vercel),
# para que el límite de intentos use la IP real del usuario. En local no hace falta.
# PROXY_SECRETO=

# --- Suscripción del club en Flow (docs/suscripcion-flow.md) ------------------
# En Railway: FLOW_MODO=sandbox o produccion, y las claves de ese modo. Vacía u otro valor: la página
# muestra "Pendiente de configuración" y el resto sigue igual (nunca cae a producción). En local se
# deja vacía: las claves no se copian a ningún .env.
FLOW_MODO=
# FLOW_SANDBOX_API_KEY=
# FLOW_SANDBOX_SECRET_KEY=
# FLOW_PROD_API_KEY=
# FLOW_PROD_SECRET_KEY=
