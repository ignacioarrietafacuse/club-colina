# Copiar a .env (que nunca se sube) para trabajar en local.
# El .env local apunta SIEMPRE a localhost. La URL de la base de producción no se guarda
# en ningún .env: en producción las variables viven en Railway y Vercel.

# --- Frontend (Vercel en producción) -----------------------------------------
# Dirección pública que va grabada en los QR (la misma que PUBLIC_BASE_URL). Obligatoria para
# `pnpm build` y `pnpm check`: sin ella el build del frontend falla. Vite la lee del entorno o de
# frontend/.env.local; con `pnpm dev` sin ella usa http://localhost:5173.
# En producción vive en Vercel (Production y Preview), en Railway (su build compila también el
# frontend) y en .github/workflows/ci.yml. En la Ola 3 se cambia a https://panel.clubcolina.cl
# en los tres lugares.
VITE_PUBLIC_BASE_URL=http://localhost:5173

# --- Backend (Railway en producción) ---------------------------------------
# Postgres local de docker-compose.yml.
DATABASE_URL=postgres://club:club@localhost:5432/club_colina
# URL pública del frontend; va grabada en los QR. En producción, por ahora la de
# vercel.app; en la Ola 3, https://panel.clubcolina.cl
PUBLIC_BASE_URL=http://localhost:5173
# Orígenes extra aceptados en escrituras (coma). En producción: la URL fija de vercel.app
# mientras PUBLIC_BASE_URL sea otra.
ORIGENES_PERMITIDOS=
PORT=3000
LOG_LEVEL=info
# En Railway: NODE_ENV=production y MIGRAR_AL_ARRANCAR=si. Con las dos, el backend aplica
# las migraciones pendientes al arrancar contra la base de Railway. En local se dejan así:
# el servidor solo migra localhost.
NODE_ENV=development
MIGRAR_AL_ARRANCAR=no
# Secreto compartido con el middleware de Vercel (misma variable en Railway y en Vercel),
# para que el límite de intentos use la IP real del usuario. En local no hace falta.
# PROXY_SECRETO=
