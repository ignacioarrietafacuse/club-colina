{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:main *)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git * --no-verify)",
      "Bash(git * --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git config core.hooksPath *)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.*.local)",
      "Bash(git -c *)",
      "Bash(git config * core.hooksPath*)",
      "Bash(git config --unset core.hooksPath*)",
      "Bash(git config --unset-all core.hooksPath*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push --force-if-includes*)",
      "Bash(git push * --force-if-includes*)",
      "Bash(git push * +*)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat */.env)",
      "Bash(cat .env.local)",
      "Bash(cat .env.production)",
      "Bash(pnpm exec railway run env*)",
      "Bash(pnpm exec railway run printenv*)",
      "Bash(pnpm exec vercel env pull*)",
      "Bash(git * -c *)",
      "Bash(git * --config-env*)",
      "Bash(git config * core.hookspath*)",
      "Bash(git config * core.HooksPath*)",
      "Bash(git * --no-verif*)",
      "Bash(git * --no-veri)",
      "Bash(git push * refs/heads/main*)",
      "Bash(gh api * git/refs*)",
      "Bash(pnpm exec railway variables)",
      "Bash(pnpm exec railway variables -*)",
      "Bash(pnpm exec railway variables --service*)",
      "Bash(pnpm exec railway variable list*)",
      "Bash(pnpm exec vercel pull*)",
      "Bash(npx railway*)",
      "Bash(npx vercel*)",
      "Bash(pnpm railway*)",
      "Bash(pnpm vercel*)",
      "Edit(./.githooks/**)",
      "Write(./.githooks/**)",
      "Edit(./.git/**)",
      "Write(./.git/**)"
    ]
  }
}
