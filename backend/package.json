    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
