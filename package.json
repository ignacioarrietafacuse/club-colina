{
  "name": "club-colina",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @club-colina/backend... build",
    "build:todo": "pnpm -r build",
    "start": "node backend/dist/server.js",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:todo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@railway/cli": "^5.71.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.2",
    "vercel": "^65.14.0"
  }
}
